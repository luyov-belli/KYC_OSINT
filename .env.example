# Copia este archivo como .env y completa los valores. Nunca subas .env al repo.

# API de Anthropic (https://console.anthropic.com). Pon un tope de gasto en la consola.
ANTHROPIC_API_KEY=

# Código que habilita el modo en vivo (búsqueda web sobre personas reales) en la app.
# El modo sintético funciona sin código.
KYC_ACCESS_CODE=

# Modelo de Claude (opcional). Por defecto: claude-opus-5-5
# KYC_MODEL=claude-opus-5-5
